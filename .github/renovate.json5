{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>MichaelSp/MichaelSp//.github/renovate.json5"],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)Chart\\.yaml$/"],
      matchStrings: [
        '^appVersion:\\s*"?(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)"?$',
        'appVersion:\\s*"?(?<currentValue>[^$"]+)"?',
      ],
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver",
      depNameTemplate: "home-assistant/core",
    },
  ],
  packageRules: [
    {
      description: "Bump chart version with dependency update",
      matchFileNames: ["charts/**/Chart.yaml"],
      bumpVersions: [
        {
          name: "Bump Helm chart version",
          filePatterns: ["{{packageFileDir}}/Chart.{yaml,yml}"],
          matchStrings: ["(?:^|\\n)version:\\s+(?<version>\\S+)"],
          bumpType:
            "{{#if isMajor}}major{{else}}{{#if isMinor}}minor{{else}}patch{{/if}}{{/if}}",
        },
      ],
    },
  ],
}
